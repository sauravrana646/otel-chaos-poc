#!/usr/bin/env bash
# poc — safe command interface for the otel-chaos-observability POC
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GIT_REV="$(git rev-parse --short=12 HEAD 2>/dev/null || echo local)"
if [[ -n "${POC_IMAGE_TAG:-}" ]]; then
  TAG="$POC_IMAGE_TAG"
elif [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
  TAG="work-$(date -u +%Y%m%d%H%M%S)"
else
  TAG="git-${GIT_REV}"
fi
REGISTRY_PREFIX="${POC_IMAGE_PREFIX:-otel-poc}"
KUBE_CONTEXT="${POC_KUBE_CONTEXT:-orbstack}"
EVIDENCE_DIR="${ROOT}/evidence"
NAMESPACE_APPS="otel-poc-apps"
NAMESPACE_OBSERVABILITY="otel-poc-observability"
NAMESPACE_TESTS="otel-poc-tests"
ARGOCD_NS="${ARGOCD_NAMESPACE:-argocd}"
FAULT_TTL_SECONDS="${POC_FAULT_TTL_SECONDS:-60}"
SYNC_TIMEOUT_SECONDS="${POC_SYNC_TIMEOUT_SECONDS:-300}"
SMOKE_PF_PID=""
TEMPO_PF_PID=""

usage() {
  cat <<'EOF'
Usage: poc <command> [options]

Commands:
  doctor                         Check tools, context, prerequisites, and capacity
  build                          Build ARM64 images and update manifest image tags
  bootstrap                      Create and strictly sync the Argo CD applications
  smoke --mock [--scenario NAME] Run normal, retry-success, retry-exhaust, or stream
  smoke --openrouter             Run exactly five sequential real-provider requests
  openrouter update [--model ID] Update the model and/or OPENROUTER_API_KEY
  openrouter verify              Verify the Secret on every python-llm pod
  retry --provider NAME --scenario NAME
                                 Mock: success|exhaust; OpenRouter: live
  load --scenario NAME --provider mock|openrouter
                                 Run baseline, spike, or configurable constant RPS
  fault --scenario NAME --provider mock|openrouter
                                 Activate db-outage, db-restart, latency, or app-restart
  verify                         Assert GitOps, workloads, monitoring, and smoke evidence
  reset                          Remove known proxy toxics and reset the mock
  destroy                        Remove stateless POC apps; retain PostgreSQL and telemetry
  destroy --data                 Explicitly remove all POC namespaces, PVCs, and data

Environment:
  POC_KUBE_CONTEXT               Kubernetes context (default: orbstack)
  POC_IMAGE_TAG                  Immutable image tag (clean: git-<commit>; dirty: timestamp)
  POC_IMAGE_PREFIX               Image prefix (default: otel-poc)
  POC_FAULT_TTL_SECONDS          Automatic toxic cleanup delay (default: 60)
  OPENROUTER_API_KEY             New key for `openrouter update`, or initial setup
  OPENROUTER_MODEL               New model for `openrouter update`, or initial setup
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required tool: $1" >&2
    exit 1
  }
}

k() {
  kubectl --context "$KUBE_CONTEXT" "$@"
}

require_cluster() {
  need kubectl
  if ! kubectl config get-contexts "$KUBE_CONTEXT" -o name 2>/dev/null | grep -Fxq "$KUBE_CONTEXT"; then
    echo "Kubernetes context '$KUBE_CONTEXT' does not exist; refusing cluster mutation." >&2
    exit 1
  fi
  if [[ "$KUBE_CONTEXT" != "orbstack" && "${POC_ALLOW_NON_ORBSTACK:-0}" != "1" ]]; then
    echo "Context '$KUBE_CONTEXT' is not OrbStack. Set POC_ALLOW_NON_ORBSTACK=1 deliberately to continue." >&2
    exit 1
  fi
  k cluster-info >/dev/null
}

cleanup_port_forwards() {
  if [[ -n "$SMOKE_PF_PID" ]]; then
    kill "$SMOKE_PF_PID" 2>/dev/null || true
    wait "$SMOKE_PF_PID" 2>/dev/null || true
    SMOKE_PF_PID=""
  fi
  if [[ -n "$TEMPO_PF_PID" ]]; then
    kill "$TEMPO_PF_PID" 2>/dev/null || true
    wait "$TEMPO_PF_PID" 2>/dev/null || true
    TEMPO_PF_PID=""
  fi
}

cleanup_tempo_port_forward() {
  if [[ -n "$TEMPO_PF_PID" ]]; then
    kill "$TEMPO_PF_PID" 2>/dev/null || true
    wait "$TEMPO_PF_PID" 2>/dev/null || true
    TEMPO_PF_PID=""
  fi
}

cleanup() {
  cleanup_port_forwards
}
trap cleanup EXIT INT TERM

cmd_doctor() {
  need kubectl
  need docker
  local failed=0
  echo "== Tools =="
  kubectl version --client
  docker version --format '{{.Server.Os}}/{{.Server.Arch}}'
  command -v argocd >/dev/null && argocd version --client || echo "argocd CLI: optional; Kubernetes API sync fallback will be used"
  command -v k6 >/dev/null && k6 version || echo "k6: missing (required only for load commands)"
  command -v jq >/dev/null && jq --version || echo "jq: missing (recommended for evidence inspection)"

  echo
  echo "== Cluster context =="
  echo "configured: $KUBE_CONTEXT"
  kubectl config current-context
  if kubectl config get-contexts "$KUBE_CONTEXT" -o name 2>/dev/null | grep -Fxq "$KUBE_CONTEXT"; then
    k get nodes -o wide
    k get storageclass
    if ! k wait nodes --all --for=condition=Ready --timeout=2s >/dev/null 2>&1; then
      echo "one or more Kubernetes nodes are not Ready" >&2
      failed=1
    fi
  else
    echo "context '$KUBE_CONTEXT' not found" >&2
    return 1
  fi

  echo
  echo "== Required shared services =="
  for ns in "$ARGOCD_NS" monitoring; do
    if k get namespace "$ns" >/dev/null 2>&1; then echo "ok: namespace/$ns"; else echo "missing: namespace/$ns"; failed=1; fi
  done
  if k get crd certificates.cert-manager.io >/dev/null 2>&1; then
    echo "ok: cert-manager CRD"
  else
    echo "missing: cert-manager CRD (the OTel Operator webhook requires cert-manager)"
    failed=1
  fi
  if k get crd applications.argoproj.io >/dev/null 2>&1; then echo "ok: Argo CD CRD"; else echo "missing: Argo CD CRD"; failed=1; fi
  [[ "$failed" -eq 0 ]]
}

update_image_reference() {
  local file="$1" name="$2" image="$3" tmp
  tmp="$(mktemp)"
  sed -E "s#(image: )[A-Za-z0-9._/:@-]*/${name}:[^[:space:]]+#\\1${image}#" "$file" >"$tmp"
  if ! grep -Fq "image: ${image}" "$tmp"; then
    rm -f "$tmp"
    echo "could not update ${name} in ${file}" >&2
    return 1
  fi
  mv "$tmp" "$file"
}

cmd_build() {
  need docker
  [[ "$TAG" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "invalid POC_IMAGE_TAG" >&2; exit 1; }
  [[ "$REGISTRY_PREFIX" =~ ^[A-Za-z0-9._/:@-]+$ ]] || { echo "invalid POC_IMAGE_PREFIX" >&2; exit 1; }
  mkdir -p "$EVIDENCE_DIR"
  local record="${EVIDENCE_DIR}/build-record-${TAG}.json"
  printf '{"tag":"%s","git_revision":"%s","built_at":"%s","images":[' \
    "$TAG" "$GIT_REV" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$record"
  local first=1

  build_one() {
    local name="$1" context="$2" dockerfile="$3" image image_id
    image="${REGISTRY_PREFIX}/${name}:${TAG}"
    echo "Building ${image} ..."
    docker build --platform linux/arm64 -t "$image" -f "$dockerfile" "$context"
    image_id="$(docker image inspect "$image" --format '{{.Id}}')"
    if [[ "$first" -eq 1 ]]; then first=0; else printf ',' >>"$record"; fi
    printf '{"name":"%s","image":"%s","image_id":"%s"}' "$name" "$image" "$image_id" >>"$record"
  }

  build_one java-api apps/java-api apps/java-api/Dockerfile
  build_one python-analysis apps/python-analysis apps/python-analysis/Dockerfile
  build_one python-llm apps/python-llm apps/python-llm/Dockerfile
  build_one llm-mock apps/llm-mock apps/llm-mock/Dockerfile
  build_one python-instrumentation-web instrumentation/python-web instrumentation/python-web/Dockerfile
  build_one python-instrumentation-genai instrumentation instrumentation/python-genai/Dockerfile
  printf ']}' >>"$record"

  update_image_reference platform/apps/deployments.yaml java-api "${REGISTRY_PREFIX}/java-api:${TAG}"
  update_image_reference platform/apps/deployments.yaml python-analysis "${REGISTRY_PREFIX}/python-analysis:${TAG}"
  update_image_reference platform/apps/deployments.yaml python-llm "${REGISTRY_PREFIX}/python-llm:${TAG}"
  update_image_reference platform/apps/deployments.yaml llm-mock "${REGISTRY_PREFIX}/llm-mock:${TAG}"
  update_image_reference platform/otel/instrumentation/instrumentation.yaml python-instrumentation-web "${REGISTRY_PREFIX}/python-instrumentation-web:${TAG}"
  update_image_reference platform/otel/instrumentation/instrumentation.yaml python-instrumentation-genai "${REGISTRY_PREFIX}/python-instrumentation-genai:${TAG}"
  sed -E -i.bak "s#^  tag:.*#  tag: ${TAG}#; s#^    java_api:.*#    java_api: ${REGISTRY_PREFIX}/java-api:${TAG}#; s#^    python_analysis:.*#    python_analysis: ${REGISTRY_PREFIX}/python-analysis:${TAG}#; s#^    python_llm:.*#    python_llm: ${REGISTRY_PREFIX}/python-llm:${TAG}#; s#^    llm_mock:.*#    llm_mock: ${REGISTRY_PREFIX}/llm-mock:${TAG}#; s#^    python_instrumentation_web:.*#    python_instrumentation_web: ${REGISTRY_PREFIX}/python-instrumentation-web:${TAG}#; s#^    python_instrumentation_genai:.*#    python_instrumentation_genai: ${REGISTRY_PREFIX}/python-instrumentation-genai:${TAG}#" compatibility.lock.yaml
  rm -f compatibility.lock.yaml.bak

  echo "Build record: $record"
  echo "Deployment manifests now reference :${TAG}. Commit and push those references before GitOps bootstrap."
}

wait_for_application() {
  local app="$1" elapsed=0 sync health operation message
  while (( elapsed < SYNC_TIMEOUT_SECONDS )); do
    sync="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.sync.status}' 2>/dev/null || echo Missing)"
    health="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.health.status}' 2>/dev/null || echo Missing)"
    operation="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)"
    printf '  %s: sync=%s health=%s operation=%s\n' "$app" "$sync" "$health" "${operation:-none}"
    if [[ "$operation" == "Failed" || "$operation" == "Error" ]]; then
      message="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.operationState.message}' 2>/dev/null || true)"
      echo "Argo CD sync failed for ${app}: ${message}" >&2
      return 1
    fi
    if [[ "$sync" == "Synced" && "$health" == "Healthy" && "$operation" != "Running" ]]; then return 0; fi
    sleep 5
    elapsed=$((elapsed + 5))
  done
  echo "timed out waiting for ${app} after ${SYNC_TIMEOUT_SECONDS}s" >&2
  k -n "$ARGOCD_NS" get application "$app" -o yaml >&2 || true
  return 1
}

sync_app() {
  local app="$1" previous_started current_started operation elapsed=0
  echo "Syncing Application/${app} using its declared targetRevision..."
  previous_started="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.operationState.startedAt}' 2>/dev/null || true)"
  k -n "$ARGOCD_NS" patch application "$app" --type merge -p '{"operation":null}' >/dev/null
  k -n "$ARGOCD_NS" patch application "$app" --type merge \
    -p '{"operation":{"initiatedBy":{"username":"poc-cli"},"sync":{}}}' >/dev/null
  while (( elapsed < 30 )); do
    operation="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)"
    current_started="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.operationState.startedAt}' 2>/dev/null || true)"
    if [[ "$operation" == "Running" || ( -n "$current_started" && "$current_started" != "$previous_started" ) ]]; then
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  wait_for_application "$app"
}

ensure_database_secret() {
  if k -n "$NAMESPACE_APPS" get secret poc-postgres-app >/dev/null 2>&1; then
    if [[ -n "${POC_DB_PASSWORD:-}" ]]; then
      echo "poc-postgres-app already exists; refusing uncoordinated password rotation." >&2
      echo "Delete/recreate the POC data explicitly if you need a new bootstrap credential." >&2
      return 1
    fi
    echo "Reusing existing poc-postgres-app Secret."
    return 0
  fi
  local db_pass="${POC_DB_PASSWORD:-}"
  if [[ -z "$db_pass" ]]; then db_pass="$(openssl rand -hex 24)"; fi
  k -n "$NAMESPACE_APPS" create secret generic poc-postgres-app \
    --from-literal=username=poc_app \
    --from-literal=password="$db_pass" \
    --from-literal=uri="postgresql://poc_app:${db_pass}@toxiproxy:5432/poc" \
    --dry-run=client -o yaml | k apply -f -
  k -n "$NAMESPACE_APPS" label secret poc-postgres-app cnpg.io/reload=true --overwrite
}

cmd_bootstrap() {
  require_cluster
  if ! k get crd certificates.cert-manager.io >/dev/null 2>&1; then
    echo "cert-manager is required by the OTel Operator webhook and is not installed." >&2
    return 1
  fi
  k get namespace "$ARGOCD_NS" >/dev/null
  k get namespace monitoring >/dev/null

  k apply -f platform/namespaces/namespaces.yaml
  ensure_database_secret
  k apply -f platform/argocd/project/project.yaml
  k apply -f platform/argocd/applications/apps.yaml
  k apply -f platform/argocd/applications/root-app.yaml

  local app
  for app in \
    otel-poc-namespaces \
    otel-poc-cnpg-operator \
    otel-poc-otel-operator \
    otel-poc-observability \
    otel-poc-instrumentation \
    otel-poc-cnpg-cluster \
    otel-poc-toxiproxy \
    otel-poc-apps \
    otel-poc-dashboards
  do
    k -n "$ARGOCD_NS" get application "$app" >/dev/null
    sync_app "$app"
  done
  echo "Bootstrap completed: every declared Application is Synced and Healthy."
}

start_java_port_forward() {
  need curl
  mkdir -p "$EVIDENCE_DIR"
  k -n "$NAMESPACE_APPS" port-forward svc/java-api 18080:8080 >"${EVIDENCE_DIR}/port-forward-java.log" 2>&1 &
  SMOKE_PF_PID=$!
  local attempt
  for attempt in $(seq 1 20); do
    if curl -fsS http://127.0.0.1:18080/healthz >/dev/null 2>&1; then return 0; fi
    sleep 0.5
  done
  echo "java-api port-forward did not become ready" >&2
  return 1
}

fetch_trace() {
  local trace_id="$1" output="$2" attempt queried=0
  k -n "$NAMESPACE_OBSERVABILITY" port-forward svc/tempo 13200:3200 >"${EVIDENCE_DIR}/port-forward-tempo.log" 2>&1 &
  TEMPO_PF_PID=$!
  for attempt in $(seq 1 120); do
    if curl -fsS "http://127.0.0.1:13200/api/traces/${trace_id}" -o "$output" 2>/dev/null; then
      queried=1
      if assert_trace_services "$output" >/dev/null 2>&1; then
        cleanup_tempo_port_forward
        return 0
      fi
    fi
    sleep 1
  done
  cleanup_tempo_port_forward
  if [[ "$queried" -eq 1 ]]; then
    echo "trace ${trace_id} remained incomplete in Tempo after 30s" >&2
    assert_trace_services "$output" || true
  else
    echo "trace ${trace_id} was not queryable from Tempo" >&2
  fi
  return 1
}

assert_trace_services() {
  local trace_file="$1" service
  for service in java-api python-analysis python-llm; do
    grep -Fq "$service" "$trace_file" || {
      echo "trace is missing service '${service}'" >&2
      return 1
    }
  done
  grep -Eq 'db\.system|db\.system\.name|postgresql' "$trace_file" || {
    echo "trace is missing a PostgreSQL client span" >&2
    return 1
  }
  grep -Fq 'gen_ai' "$trace_file" || {
    echo "trace is missing GenAI instrumentation attributes" >&2
    return 1
  }
}

run_smoke_request() {
  local scenario="$1" suffix="${2:-one}" provider="${3:-mock}" rid trace_id span_id response repeat_response status expected trace_file stats
  rid="smoke-${scenario}-$(date +%s)-${suffix}"
  trace_id="$(printf '%s' "$rid" | shasum -a 256 | cut -c1-32)"
  span_id="$(printf '%s-span' "$rid" | shasum -a 256 | cut -c1-16)"
  response="${EVIDENCE_DIR}/${rid}.response.json"
  trace_file="${EVIDENCE_DIR}/${rid}.trace.json"
  expected=200
  if [[ "$scenario" == "retry-exhaust" ]]; then expected=502; fi

  status="$(curl -sS -o "$response" -w '%{http_code}' -X POST http://127.0.0.1:18080/api/recommendations \
    -H 'content-type: application/json' \
    -H "traceparent: 00-${trace_id}-${span_id}-01" \
    -d "{\"request_id\":\"${rid}\",\"item_id\":\"item-100\",\"scenario\":\"${scenario}\",\"provider\":\"${provider}\"}")"
  if [[ "$status" != "$expected" ]]; then
    echo "expected HTTP ${expected}, received ${status}; response: ${response}" >&2
    return 1
  fi
  if [[ "$expected" == "200" ]]; then grep -Fq "\"request_id\":\"${rid}\"" "$response"; fi
  if [[ "$expected" == "200" ]]; then
    repeat_response="${EVIDENCE_DIR}/${rid}.repeat.json"
    curl -fsS -X POST http://127.0.0.1:18080/api/recommendations \
      -H 'content-type: application/json' \
      -d "{\"request_id\":\"${rid}\",\"item_id\":\"item-100\",\"scenario\":\"${scenario}\",\"provider\":\"${provider}\"}" \
      -o "$repeat_response"
    cmp "$response" "$repeat_response" || {
      echo "idempotent repeat returned a different response" >&2
      return 1
    }
  fi
  if [[ "$provider" == "mock" && ( "$scenario" == "retry-success" || "$scenario" == "retry-exhaust" ) ]]; then
    stats="$(k -n "$NAMESPACE_APPS" exec deploy/llm-mock -- python -c \
      "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8080/admin/stats/${rid}').read().decode())")"
    printf '%s' "$stats" | grep -Eq '"attempts"[[:space:]]*:[[:space:]]*3' || {
      echo "expected exactly three provider attempts; stats=${stats}" >&2
      return 1
    }
  fi
  fetch_trace "$trace_id" "$trace_file"
  assert_trace_services "$trace_file"
  printf '{"request_id":"%s","scenario":"%s","provider":"%s","trace_id":"%s","http_status":%s,"trace_file":"%s"}\n' \
    "$rid" "$scenario" "$provider" "$trace_id" "$status" "$trace_file" >"${EVIDENCE_DIR}/last-smoke.json"
  echo "Smoke passed: provider=${provider} scenario=${scenario} status=${status} trace_id=${trace_id}"
}

cmd_smoke_mock() {
  require_cluster
  local scenario="${1:-normal}"
  case "$scenario" in normal|retry-success|retry-exhaust|stream) ;; *) echo "unsupported mock scenario: $scenario" >&2; return 1 ;; esac
  start_java_port_forward
  run_smoke_request "$scenario" one mock
  cleanup_port_forwards
}

cmd_smoke_openrouter() {
  require_cluster
  need curl
  ensure_openrouter_credentials

  start_java_port_forward
  local i
  for i in 1 2 3 4 5; do
    run_smoke_request normal "openrouter-${i}" openrouter
  done
  cleanup_port_forwards
  echo "OpenRouter smoke completed with five sequential requests. Requests without --provider openrouter still use mock."
}

ensure_openrouter_credentials() {
  if ! k -n "$NAMESPACE_APPS" get secret openrouter >/dev/null 2>&1; then
    echo "OpenRouter Secret does not exist. Run: poc openrouter update --model MODEL" >&2
    return 2
  fi
  read_openrouter_secret
  if ! wait_for_openrouter_projection 1; then
    echo "Run 'poc openrouter update' to update the pods before starting a test." >&2
    return 1
  fi
}

read_openrouter_secret() {
  OPENROUTER_EXPECTED_API_KEY="$(k -n "$NAMESPACE_APPS" get secret openrouter \
    -o go-template='{{index .data "api-key" | base64decode}}')"
  OPENROUTER_EXPECTED_MODEL="$(k -n "$NAMESPACE_APPS" get secret openrouter \
    -o go-template='{{index .data "model" | base64decode}}')"
}

masked_value() {
  local value="$1" length
  length=${#value}
  if (( length <= 8 )); then
    printf '%*s' "$length" '' | tr ' ' '*'
  else
    printf '%s...%s' "${value:0:4}" "${value: -4}"
  fi
}

print_openrouter_configuration() {
  local pod_count="$1"
  echo "OpenRouter model: $OPENROUTER_EXPECTED_MODEL"
  echo "OpenRouter API key: $(masked_value "$OPENROUTER_EXPECTED_API_KEY")"
  echo "Secret projection: verified on ${pod_count} python-llm pod(s)"
}

apply_openrouter_secret() (
  local credentials_dir
  credentials_dir="$(mktemp -d "${TMPDIR:-/tmp}/otel-poc-openrouter.XXXXXX")"
  trap 'rm -f "$credentials_dir/api-key" "$credentials_dir/model"; rmdir "$credentials_dir"' EXIT
  chmod 700 "$credentials_dir"
  printf '%s' "$OPENROUTER_EXPECTED_API_KEY" >"$credentials_dir/api-key"
  printf '%s' "$OPENROUTER_EXPECTED_MODEL" >"$credentials_dir/model"
  chmod 600 "$credentials_dir/api-key" "$credentials_dir/model"
  k -n "$NAMESPACE_APPS" create secret generic openrouter \
    --from-file=api-key="$credentials_dir/api-key" \
    --from-file=model="$credentials_dir/model" \
    --dry-run=client -o yaml | k apply -f - >/dev/null
)

wait_for_openrouter_projection() {
  local max_attempts="$1" attempt pod ready pod_count pod_key pod_model
  for attempt in $(seq 1 "$max_attempts"); do
    ready=1
    pod_count=0
    while IFS= read -r pod; do
      if [[ -n "$pod" ]]; then
        pod_count=$((pod_count + 1))
        pod_key="$(k -n "$NAMESPACE_APPS" exec "$pod" -- \
          cat /var/run/secrets/openrouter/api-key 2>/dev/null || true)"
        pod_model="$(k -n "$NAMESPACE_APPS" exec "$pod" -- \
          cat /var/run/secrets/openrouter/model 2>/dev/null || true)"
        [[ "$pod_key" == "$OPENROUTER_EXPECTED_API_KEY" ]] || ready=0
        [[ "$pod_model" == "$OPENROUTER_EXPECTED_MODEL" ]] || ready=0
      fi
    done < <(k -n "$NAMESPACE_APPS" get pods -l app.kubernetes.io/name=python-llm \
      --field-selector=status.phase=Running -o name)
    if [[ "$ready" -eq 1 && "$pod_count" -gt 0 ]]; then
      print_openrouter_configuration "$pod_count"
      return 0
    fi
    if (( max_attempts == 1 )); then
      echo "OpenRouter Secret does not match every running python-llm pod." >&2
      return 1
    fi
    if (( attempt % 15 == 0 )); then
      echo "Waiting for exact OpenRouter Secret projection (${attempt}s/${max_attempts}s)..." >&2
    fi
    sleep 1
  done
  echo "OpenRouter Secret did not reach every python-llm pod after ${max_attempts}s" >&2
  return 1
}

update_openrouter_credentials() {
  local requested_model="${1:-}" announce="${2:-true}" existing_key="" existing_model=""
  if k -n "$NAMESPACE_APPS" get secret openrouter >/dev/null 2>&1; then
    read_openrouter_secret
    existing_key="$OPENROUTER_EXPECTED_API_KEY"
    existing_model="$OPENROUTER_EXPECTED_MODEL"
  fi

  OPENROUTER_EXPECTED_API_KEY="${OPENROUTER_API_KEY:-$existing_key}"
  OPENROUTER_EXPECTED_MODEL="${requested_model:-${OPENROUTER_MODEL:-$existing_model}}"
  if [[ -z "$OPENROUTER_EXPECTED_API_KEY" || -z "$OPENROUTER_EXPECTED_MODEL" ]]; then
    echo "Initial setup requires OPENROUTER_API_KEY and --model or OPENROUTER_MODEL." >&2
    return 2
  fi

  apply_openrouter_secret
  wait_for_openrouter_projection 120
  [[ "$announce" == false ]] || echo "OpenRouter configuration updated."
}

cmd_openrouter() {
  local action="${1:-}" model=""
  shift || true
  require_cluster
  case "$action" in
    update)
      while [[ "$#" -gt 0 ]]; do
        case "$1" in
          --model) model="${2:-}"; shift 2 ;;
          *) echo "unknown openrouter update option: $1" >&2; return 1 ;;
        esac
      done
      update_openrouter_credentials "$model" true
      ;;
    verify)
      [[ "$#" -eq 0 ]] || { echo "usage: poc openrouter verify" >&2; return 1; }
      k -n "$NAMESPACE_APPS" get secret openrouter >/dev/null 2>&1 || {
        echo "OpenRouter Secret does not exist. Run: poc openrouter update --model MODEL" >&2
        return 2
      }
      read_openrouter_secret
      wait_for_openrouter_projection 1
      ;;
    *)
      echo "usage: poc openrouter update [--model MODEL] | verify" >&2
      return 1
      ;;
  esac
}

cmd_retry() {
  local provider="" scenario=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --provider) provider="${2:-}"; shift 2 ;;
      --scenario) scenario="${2:-}"; shift 2 ;;
      *) echo "unknown retry option: $1" >&2; return 1 ;;
    esac
  done
  case "$provider:$scenario" in
    mock:success) cmd_smoke_mock retry-success ;;
    mock:exhaust) cmd_smoke_mock retry-exhaust ;;
    openrouter:live)
      require_cluster
      ensure_openrouter_credentials
      start_java_port_forward
      run_smoke_request normal openrouter-live-retry-policy openrouter
      cleanup_port_forwards
      echo "OpenRouter live request passed; up to three attempts are enabled for genuine 429, 503, or connection failures."
      ;;
    *)
      echo "usage: poc retry --provider mock --scenario success|exhaust" >&2
      echo "   or: poc retry --provider openrouter --scenario live" >&2
      return 1
      ;;
  esac
}

cmd_load() {
  local scenario="${1:-}" provider="mock" rps="" duration="" summary script load_base
  shift || true
  need k6
  mkdir -p "$EVIDENCE_DIR"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --provider) provider="${2:-}"; shift 2 ;;
      --rps) rps="${2:-}"; shift 2 ;;
      --duration) duration="${2:-}"; shift 2 ;;
      *) echo "unknown load option: $1" >&2; return 1 ;;
    esac
  done
  case "$scenario" in
    baseline)
      [[ -z "$rps" && -z "$duration" ]] || { echo "baseline has fixed rate and duration; use constant for --rps/--duration" >&2; return 1; }
      summary="${EVIDENCE_DIR}/k6-baseline.json"
      script=tests/k6/baseline.js
      ;;
    spike)
      [[ -z "$rps" && -z "$duration" ]] || { echo "spike has fixed stages; use constant for --rps/--duration" >&2; return 1; }
      summary="${EVIDENCE_DIR}/k6-spike.json"
      script=tests/k6/spike.js
      ;;
    constant)
      [[ "$rps" =~ ^[1-9][0-9]*$ ]] || { echo "--rps must be a positive integer" >&2; return 1; }
      [[ "$duration" =~ ^[1-9][0-9]*(s|m|h)$ ]] || { echo "--duration must look like 30s, 2m, or 1h" >&2; return 1; }
      summary="${EVIDENCE_DIR}/k6-constant-${rps}rps-$(date -u +%Y%m%d%H%M%S).json"
      script=tests/k6/constant.js
      ;;
    *) echo "unknown load scenario: $scenario (baseline|spike|constant)" >&2; return 1 ;;
  esac

  [[ "$provider" == "mock" || "$provider" == "openrouter" ]] || {
    echo "--provider must be mock or openrouter" >&2
    return 1
  }
  require_cluster
  if [[ "$provider" == "openrouter" ]]; then
    ensure_openrouter_credentials
  fi

  load_base="${JAVA_API_BASE:-}"
  if [[ -z "$load_base" ]]; then
    start_java_port_forward
    load_base=http://127.0.0.1:18080
  fi

  if [[ "$scenario" == "constant" ]]; then
    JAVA_API_BASE="$load_base" POC_PROVIDER="$provider" POC_RPS="$rps" POC_DURATION="$duration" \
      k6 run --summary-export "$summary" "$script"
  else
    JAVA_API_BASE="$load_base" POC_PROVIDER="$provider" k6 run --summary-export "$summary" "$script"
  fi
  cleanup_port_forwards
  echo "k6 summary: ${summary}"
}

schedule_toxic_cleanup() {
  local proxy="$1" toxic="$2" safe_toxic job
  safe_toxic="$(printf '%s' "$toxic" | tr -cd 'a-z0-9-')"
  job="toxic-cleanup-${safe_toxic}-$(date +%s)"
  k -n "$NAMESPACE_TESTS" apply -f - <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job}
  labels:
    app.kubernetes.io/part-of: otel-chaos-poc
spec:
  activeDeadlineSeconds: $((FAULT_TTL_SECONDS + 60))
  ttlSecondsAfterFinished: 600
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: cleanup
          image: curlimages/curl:8.12.1
          command: ["/bin/sh", "-ec"]
          args:
            - |
              sleep ${FAULT_TTL_SECONDS}
              code="\$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE \
                http://toxiproxy.${NAMESPACE_APPS}.svc:8474/proxies/${proxy}/toxics/${toxic})"
              [ "\$code" = "204" ] || [ "\$code" = "404" ]
EOF
  echo "Cleanup Job/${job} will remove ${toxic} after ${FAULT_TTL_SECONDS}s."
}

toxiproxy() {
  k -n "$NAMESPACE_APPS" exec deploy/toxiproxy -- /toxiproxy-cli "$@"
}

cmd_fault() {
  require_cluster
  local scenario="${1:-}" provider="mock" pod
  shift || true
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --provider) provider="${2:-}"; shift 2 ;;
      *) echo "unknown fault option: $1" >&2; return 1 ;;
    esac
  done
  [[ "$provider" == "mock" || "$provider" == "openrouter" ]] || {
    echo "--provider must be mock or openrouter" >&2
    return 1
  }
  if [[ "$provider" == "openrouter" ]]; then ensure_openrouter_credentials; fi
  case "$scenario" in
    db-outage)
      schedule_toxic_cleanup postgres db-outage
      toxiproxy toxic add --toxicName db-outage -t timeout -a timeout=1 postgres
      ;;
    latency)
      schedule_toxic_cleanup llm-http llm-latency
      toxiproxy toxic add --toxicName llm-latency -t latency -a latency=500 -a jitter=0 llm-http
      ;;
    db-restart)
      pod="$(k -n "$NAMESPACE_APPS" get pods -l cnpg.io/cluster=poc-postgres -o jsonpath='{.items[0].metadata.name}')"
      [[ -n "$pod" ]] || { echo "no CloudNativePG pod found" >&2; return 1; }
      k -n "$NAMESPACE_APPS" delete pod "$pod" --wait=false
      k -n "$NAMESPACE_APPS" wait cluster/poc-postgres --for=condition=Ready --timeout=180s
      ;;
    app-restart)
      pod="$(k -n "$NAMESPACE_APPS" get pods -l app.kubernetes.io/name=python-analysis --field-selector=status.phase=Running -o jsonpath='{.items[0].metadata.name}')"
      [[ -n "$pod" ]] || { echo "no running python-analysis pod found" >&2; return 1; }
      echo "Deleting exactly one pod: ${pod}"
      k -n "$NAMESPACE_APPS" delete pod "$pod" --wait=false
      k -n "$NAMESPACE_APPS" rollout status deployment/python-analysis --timeout=120s
      ;;
    *)
      echo "unknown fault: $scenario (db-outage|db-restart|latency|app-restart)" >&2
      return 1
      ;;
  esac
}

remove_toxic_if_present() {
  local proxy="$1" toxic="$2" inspected
  if ! inspected="$(toxiproxy inspect "$proxy")"; then
    echo "failed to inspect Toxiproxy proxy ${proxy}" >&2
    return 1
  fi
  if printf '%s\n' "$inspected" | grep -Fq "$toxic"; then
    toxiproxy toxic remove --toxicName "$toxic" "$proxy"
  fi
  if ! inspected="$(toxiproxy inspect "$proxy")"; then
    echo "failed to verify Toxiproxy proxy ${proxy}" >&2
    return 1
  fi
  if printf '%s\n' "$inspected" | grep -Fq "$toxic"; then
    echo "failed to remove toxic ${toxic} from ${proxy}" >&2
    return 1
  fi
}

cmd_reset() {
  require_cluster
  remove_toxic_if_present postgres db-outage
  remove_toxic_if_present llm-http llm-latency
  k -n "$NAMESPACE_APPS" exec deploy/llm-mock -- \
    python -c 'import urllib.request; urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:8080/admin/reset", method="POST"))'
  echo "Known toxics removed and verified; mock reset; PostgreSQL data retained."
}

cmd_verify() {
  require_cluster
  local failed=0 app sync health
  for app in otel-poc-namespaces otel-poc-cnpg-operator otel-poc-otel-operator \
    otel-poc-observability otel-poc-instrumentation otel-poc-cnpg-cluster \
    otel-poc-toxiproxy otel-poc-apps otel-poc-dashboards
  do
    sync="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.sync.status}' 2>/dev/null || echo Missing)"
    health="$(k -n "$ARGOCD_NS" get application "$app" -o jsonpath='{.status.health.status}' 2>/dev/null || echo Missing)"
    printf '%-32s sync=%-8s health=%s\n' "$app" "$sync" "$health"
    if [[ "$sync" != "Synced" || "$health" != "Healthy" ]]; then failed=1; fi
  done

  local deployment
  while IFS= read -r deployment; do
    [[ -z "$deployment" ]] || k -n "$NAMESPACE_APPS" rollout status "$deployment" --timeout=5s || failed=1
  done < <(k -n "$NAMESPACE_APPS" get deployment -o name 2>/dev/null || true)
  while IFS= read -r deployment; do
    [[ -z "$deployment" ]] || k -n "$NAMESPACE_OBSERVABILITY" rollout status "$deployment" --timeout=5s || failed=1
  done < <(k -n "$NAMESPACE_OBSERVABILITY" get deployment -o name 2>/dev/null || true)
  k -n "$NAMESPACE_OBSERVABILITY" rollout status daemonset/cnpg-log-collector --timeout=5s || failed=1
  k -n "$NAMESPACE_APPS" wait cluster/poc-postgres --for=condition=Ready --timeout=5s || failed=1
  k -n "$NAMESPACE_APPS" get podmonitor poc-postgres >/dev/null || failed=1
  local init_names
  init_names="$(k -n "$NAMESPACE_APPS" get pods -l app.kubernetes.io/name=java-api -o jsonpath='{.items[0].spec.initContainers[*].name}' 2>/dev/null || true)"
  [[ "$init_names" == *opentelemetry-auto-instrumentation* ]] || { echo "Java auto-instrumentation init container missing" >&2; failed=1; }
  init_names="$(k -n "$NAMESPACE_APPS" get pods -l app.kubernetes.io/name=python-analysis -o jsonpath='{.items[0].spec.initContainers[*].name}' 2>/dev/null || true)"
  [[ "$init_names" == *opentelemetry-auto-instrumentation* ]] || { echo "Python auto-instrumentation init container missing" >&2; failed=1; }

  if [[ -f "${EVIDENCE_DIR}/last-smoke.json" ]]; then
    local trace_file
    trace_file="$(sed -n 's/.*"trace_file":"\([^"]*\)".*/\1/p' "${EVIDENCE_DIR}/last-smoke.json")"
    [[ -n "$trace_file" && -f "$trace_file" ]] && assert_trace_services "$trace_file" || failed=1
    echo "Smoke evidence: ${EVIDENCE_DIR}/last-smoke.json"
  else
    echo "missing smoke evidence; run ./cli/poc smoke --mock" >&2
    failed=1
  fi

  if [[ "$failed" -ne 0 ]]; then
    echo "verification failed" >&2
    return 1
  fi
  echo "verification passed"
}

delete_app_orphan() {
  local app="$1"
  k -n "$ARGOCD_NS" patch application "$app" --type merge -p '{"metadata":{"finalizers":null}}' >/dev/null 2>&1 || true
  k -n "$ARGOCD_NS" delete application "$app" --ignore-not-found
}

delete_app_cascade() {
  local app="$1"
  k -n "$ARGOCD_NS" patch application "$app" --type merge \
    -p '{"metadata":{"finalizers":["resources-finalizer.argocd.argoproj.io"]}}' >/dev/null 2>&1 || true
  k -n "$ARGOCD_NS" delete application "$app" --ignore-not-found --timeout=120s
}

cmd_destroy() {
  require_cluster
  local mode="${1:-retain-data}" answer app
  if [[ "$mode" == "--data" ]]; then
    read -r -p "This deletes PostgreSQL, Tempo, Loki PVCs and all POC data. Type 'delete-poc-data': " answer
    [[ "$answer" == "delete-poc-data" ]] || { echo "Aborted."; return 1; }
    delete_app_orphan otel-poc-root
    for app in otel-poc-dashboards otel-poc-apps otel-poc-toxiproxy otel-poc-cnpg-cluster \
      otel-poc-instrumentation otel-poc-observability otel-poc-otel-operator \
      otel-poc-cnpg-operator otel-poc-namespaces; do
      delete_app_cascade "$app"
    done
    k delete namespace "$NAMESPACE_TESTS" "$NAMESPACE_APPS" "$NAMESPACE_OBSERVABILITY" \
      otel-poc-system otel-poc-cnpg-system --ignore-not-found --wait=false
    echo "Full POC deletion requested, including data-bearing PVCs."
    return 0
  fi
  [[ "$mode" == "retain-data" ]] || { echo "usage: poc destroy [--data]" >&2; return 1; }
  read -r -p "Remove stateless apps/tests while retaining PostgreSQL and telemetry data? Type 'destroy-apps': " answer
  [[ "$answer" == "destroy-apps" ]] || { echo "Aborted."; return 1; }
  delete_app_orphan otel-poc-root
  for app in otel-poc-dashboards otel-poc-apps otel-poc-toxiproxy otel-poc-instrumentation; do
    delete_app_cascade "$app"
  done
  k delete namespace "$NAMESPACE_TESTS" --ignore-not-found --wait=false
  echo "Stateless POC apps removed. CloudNativePG, Tempo, Loki, their PVCs, and operators were retained."
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    -h|--help|help|"") usage ;;
    doctor) cmd_doctor "$@" ;;
    build) cmd_build "$@" ;;
    bootstrap) cmd_bootstrap "$@" ;;
    openrouter) cmd_openrouter "$@" ;;
    smoke)
      case "${1:-}" in
        --mock)
          shift
          if [[ "${1:-}" == "--scenario" ]]; then cmd_smoke_mock "${2:-}"; else cmd_smoke_mock normal; fi
          ;;
        --openrouter) cmd_smoke_openrouter ;;
        *) echo "usage: poc smoke --mock [--scenario normal|retry-success|retry-exhaust|stream] | --openrouter" >&2; return 1 ;;
      esac
      ;;
    load)
      [[ "${1:-}" == "--scenario" ]] || { echo "usage: poc load --scenario baseline|spike|constant [--rps N --duration 30s|2m|1h]" >&2; return 1; }
      shift
      cmd_load "$@"
      ;;
    retry) cmd_retry "$@" ;;
    fault|chaos)
      [[ "${1:-}" == "--scenario" ]] || { echo "usage: poc fault --scenario NAME --provider mock|openrouter" >&2; return 1; }
      shift
      cmd_fault "$@"
      ;;
    verify) cmd_verify "$@" ;;
    reset) cmd_reset "$@" ;;
    destroy) cmd_destroy "$@" ;;
    *) echo "unknown command: $cmd" >&2; usage; return 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
