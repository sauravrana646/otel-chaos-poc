# Example only — do not commit real passwords.
# Created automatically by `./cli/poc bootstrap` with a generated password unless
# POC_DB_PASSWORD is set.
apiVersion: v1
kind: Secret
metadata:
  name: poc-postgres-app
  namespace: otel-poc-apps
  labels:
    cnpg.io/reload: "true"
type: kubernetes
stringData:
  username: poc_app
  password: REPLACE_ME
  uri: postgresql://poc_app:REPLACE_ME@toxiproxy:5432/poc
