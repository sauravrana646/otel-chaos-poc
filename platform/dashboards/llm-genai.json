{
  "uid": "otel-poc-llm-genai",
  "title": "OTel POC — LLM / GenAI",
  "tags": ["otel-poc", "llm", "genai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "python-llm",
        "current": {
          "text": "python-llm",
          "value": "python-llm"
        },
        "options": [
          {
            "text": "python-llm",
            "value": "python-llm",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "GenAI metrics",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "From `opentelemetry-instrumentation-openai-v2`: histograms `gen_ai.client.token.usage` and `gen_ai.client.operation.duration`.\\n\\n**Tokens/sec** = `rate(gen_ai_client_token_usage_sum[1m])`. Token type: `input` (prompt) vs `output`/`completion`."
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Tokens per second (by type)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{service_name=\"$service\"}[1m]))",
          "legendFormat": "{{gen_ai_token_type}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Token usage rate (total)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_token_usage_sum{service_name=\"$service\"}[1m]))",
          "legendFormat": "tokens/s",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Tokens per call (avg)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{service_name=\"$service\"}[5m])) / clamp_min(sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_count{service_name=\"$service\"}[5m])), 1e-9)",
          "legendFormat": "{{gen_ai_token_type}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "GenAI operation duration p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=\"$service\"}[5m])))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=\"$service\"}[5m])))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=\"$service\"}[5m])))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "GenAI ops / sec",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count{service_name=\"$service\"}[1m]))",
          "legendFormat": "ops/s",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Token usage by model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{service_name=\"$service\"}[1m]))",
          "legendFormat": "{{gen_ai_request_model}} / {{gen_ai_token_type}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "Tokens (last 15m)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_token_type) (increase(gen_ai_client_token_usage_sum{service_name=\"$service\"}[15m]))",
          "legendFormat": "{{gen_ai_token_type}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 9,
      "title": "Avg op duration (15m)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_sum{service_name=\"$service\"}[15m])) / clamp_min(sum(rate(gen_ai_client_operation_duration_seconds_count{service_name=\"$service\"}[15m])), 1e-9)",
          "legendFormat": "avg",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "instant": true
        }
      ]
    }
  ]
}
