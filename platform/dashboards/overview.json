    {
      "type": "text",
      "id": 1,
      "title": "How to use",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Metrics** (Prometheus) \u00b7 **Traces** (Tempo-POC) \u00b7 **Logs** (Loki-POC)\\n\\n- Ingress RPS counts only `java-api` `POST /api/recommendations` (health excluded).\\n- Jump to **Explore \u2192 Tempo-POC** for full traces; use Traces & Logs dashboard for correlation."
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Ingress RPS (java-api /api/recommendations)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"java-api\",http_route=\"/api/recommendations\"}[1m]))",
          "legendFormat": "rps",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
