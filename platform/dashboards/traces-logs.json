{
  "uid": "otel-poc-traces-logs",
  "title": "OTel POC \u2014 Traces & Logs",
  "tags": [
    "otel-poc",
    "traces",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "java-api,python-analysis,python-llm",
        "current": {
          "text": "java-api",
          "value": "java-api"
        },
        "options": [
          {
            "text": "java-api",
            "value": "java-api",
            "selected": true
          },
          {
            "text": "python-analysis",
            "value": "python-analysis",
            "selected": false
          },
          {
            "text": "python-llm",
            "value": "python-llm",
            "selected": false
          }
        ],
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "Trace / log navigation",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Quick links\\n1. **Explore \u2192 Tempo-POC** \u2014 TraceQL: `{ resource.service.name=\\\"java-api\\\" && name=\\\"POST /api/recommendations\\\" }`\\n2. Open a trace \u2192 **Logs for this span**\\n3. **Explore \u2192 Loki-POC** \u2014 `{service_name=\\\"java-api\\\"}`"
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Span duration p95 (ms) by span",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"$service\"}[1m])) by (le, span_name))",
          "legendFormat": "{{span_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Span call rate by status",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"$service\"}[1m])) by (status_code, span_kind)",
          "legendFormat": "{{span_kind}} {{status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Client \u2192 server edges (service graph)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_service_graph_request_total[1m])) by (client, server)",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(traces_service_graph_request_failed_total[1m])) by (client, server)",
          "legendFormat": "FAIL {{client}} \u2192 {{server}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "logs",
      "id": 5,
      "title": "Application logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-poc"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"java-api|python-analysis|python-llm\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki-poc"
          },
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "id": 6,
      "title": "Selected service error-ish logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-poc"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"$service\"} |~ \"(?i)error|exception|fail|502|503|timeout\"",
          "datasource": {
            "type": "loki",
            "uid": "loki-poc"
          },
          "queryType": "range"
        }
      ]
    }
  ]
}
